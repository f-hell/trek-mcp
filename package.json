{
  "name": "trek-mcp",
  "version": "0.1.0",
  "description": "Personal-use MCP server for planning hiking trips in Norway using ut.no and DNT hyttebestilling data.",
  "private": true,
  "type": "module",
  "bin": { "trek-mcp": "dist/index.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "recon": "tsx scripts/recon.ts",
    "introspect:utno": "tsx scripts/introspect.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
